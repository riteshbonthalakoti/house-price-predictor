---
import '../styles/global.css';
---

<html lang="en"><head>
<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>ProphecyAI — Property Valuation Model</title>
<meta name="description" content="AI-powered real estate price prediction. Adjust property parameters and get an instant market valuation." />
<link rel="icon" type="image/jpeg" href="/favicon.ico" />
<!-- Material Symbols -->
<link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
<!-- Geist font -->
<link href="https://fonts.googleapis.com" rel="preconnect" />
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
<link href="/assets/cfb014fc4a227b9dffe7c39e5581d5f7.css" rel="stylesheet" />
<script id="tailwind-noop">/* Tailwind v4 loaded via @tailwindcss/vite — no CDN script needed */</script>
</head>

<body class="text-on-surface pb-24 md:pb-0">
<header class="hidden md:flex fixed top-0 w-full z-50 justify-between items-center px-container-padding-desktop h-16 bg-surface/80 backdrop-blur-xl border-b border-white/50 shadow-sm">
  <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-primary" data-icon="analytics">analytics</span>
    <span class="font-display-lg text-display-lg font-bold text-primary">ProphecyAI</span>
  </div>
  <nav class="flex gap-6">
    <a class="font-label-md text-label-md text-primary hover:bg-white/20 transition-colors px-3 py-2 rounded-md" href="#">Insight</a>
    <a class="font-label-md text-label-md text-on-surface-variant hover:bg-white/20 transition-colors px-3 py-2 rounded-md" href="#">Forecast</a>
    <a class="font-label-md text-label-md text-on-surface-variant hover:bg-white/20 transition-colors px-3 py-2 rounded-md" href="#">Assets</a>
    <a class="font-label-md text-label-md text-on-surface-variant hover:bg-white/20 transition-colors px-3 py-2 rounded-md" href="#">Settings</a>
  </nav>
  <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-primary font-bold">R</div>
</header>
<header class="md:hidden fixed top-0 w-full z-50 flex justify-between items-center px-container-padding-mobile h-16 bg-surface/80 backdrop-blur-xl border-b border-white/50 shadow-sm">
  <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-primary" data-icon="analytics">analytics</span>
    <span class="font-headline-md text-headline-md font-bold text-primary">ProphecyAI</span>
  </div>
  <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-primary font-bold">R</div>
</header>

<main class="pt-20 md:pt-24 px-container-padding-mobile md:px-container-padding-desktop max-w-7xl mx-auto flex flex-col gap-panel-gap">
  <div class="mb-2">
    <h1 class="font-headline-lg text-headline-lg text-on-surface">Property Valuation Model</h1>
    <p class="font-body-md text-body-md text-on-surface-variant mt-2 max-w-2xl">Adjust parameters to generate a real-time predictive valuation based on current market analytics.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
    <div class="col-span-1 md:col-span-5 flex flex-col gap-6">
      <div class="glass-panel rounded-xl p-6 flex flex-col gap-6">

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="font-label-md text-label-md text-on-surface">Property Size (sq ft)</label>
            <div id="val-size" class="font-label-md text-label-md bg-surface-container-low px-2 py-1 rounded text-on-surface-variant">1,850 sq ft</div>
          </div>
          <input id="slider-size" class="w-full" max="5000" min="500" type="range" value="1850" />
          <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1"><span>500</span><span>5000+</span></div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="font-label-md text-label-md text-on-surface">Number of Bedrooms</label>
            <div id="val-bedrooms" class="font-label-md text-label-md bg-surface-container-low px-3 py-1 rounded text-on-surface-variant">3</div>
          </div>
          <input id="slider-bedrooms" class="w-full" max="6" min="1" type="range" value="3" />
          <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1"><span>1</span><span>6+</span></div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="font-label-md text-label-md text-on-surface">Number of Bathrooms</label>
            <div id="val-bathrooms" class="font-label-md text-label-md bg-surface-container-low px-3 py-1 rounded text-on-surface-variant">2.5</div>
          </div>
          <input id="slider-bathrooms" class="w-full" max="5" min="1" step="0.5" type="range" value="2.5" />
          <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1"><span>1</span><span>5+</span></div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="font-label-md text-label-md text-on-surface">Property Age (years)</label>
            <div id="val-age" class="font-label-md text-label-md bg-surface-container-low px-2 py-1 rounded text-on-surface-variant">8 years</div>
          </div>
          <input id="slider-age" class="w-full" max="50" min="0" type="range" value="8" />
          <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1"><span>0</span><span>50+</span></div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="font-label-md text-label-md text-on-surface">Location Score (1–10)</label>
            <div id="val-location" class="font-label-md text-label-md bg-surface-container-low px-3 py-1 rounded text-on-surface-variant">8.2</div>
          </div>
          <input id="slider-location" class="w-full" max="10" min="1" step="0.1" type="range" value="8.2" />
          <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1"><span>1</span><span>10</span></div>
        </div>

        <button id="predict-btn" class="w-full bg-primary-container text-on-primary font-label-md text-label-md py-4 rounded-xl mt-2 hover:bg-primary transition-colors flex justify-center items-center gap-2 shadow-sm">
          <span class="material-symbols-outlined" data-icon="calculate">calculate</span>
          Calculate Valuation
        </button>
        <p id="error-msg" class="text-red-600 font-label-sm text-label-sm text-center hidden">Unable to reach the prediction API. Is the backend running?</p>
      </div>
    </div>

    <div class="col-span-1 md:col-span-7 flex flex-col gap-6">
      <div class="glass-panel rounded-xl p-8 flex flex-col items-center justify-center min-h-[240px] relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-primary-fixed/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
        <span class="font-label-md text-label-md text-on-surface-variant mb-4 relative z-10">Estimated Market Value</span>
        <div id="price-display" class="font-display-lg text-display-lg text-on-surface font-semibold mb-4 flex items-baseline gap-2 relative z-10 price-animate">
          <span class="text-3xl text-on-surface-variant font-medium">₹</span>
          <span id="price-value">185.70</span>
          <span class="text-3xl text-on-surface-variant font-medium">Lakhs</span>
        </div>
        <div id="trend-badge" class="flex items-center gap-2 bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-full border border-emerald-100 relative z-10">
          <span class="material-symbols-outlined text-sm" data-icon="trending_up">trending_up</span>
          <span id="trend-text" class="font-label-sm text-label-sm">AI-powered estimate</span>
        </div>
      </div>

      <div class="glass-panel rounded-xl p-6 flex flex-col">
        <h3 class="font-headline-md text-headline-md text-on-surface mb-6">Feature Importance</h3>
        <div class="flex-grow flex items-end justify-between h-64 gap-2 md:gap-6 pt-8 relative">
          <div class="absolute left-0 top-0 bottom-0 flex flex-col justify-between text-on-surface-variant font-label-sm text-label-sm pb-8 w-8">
            <span>40%</span><span>30%</span><span>20%</span><span>10%</span><span>0%</span>
          </div>
          <div class="absolute left-8 right-0 top-0 bottom-8 flex flex-col justify-between pointer-events-none">
            <div class="w-full border-t border-outline-variant/30"></div>
            <div class="w-full border-t border-outline-variant/30"></div>
            <div class="w-full border-t border-outline-variant/30"></div>
            <div class="w-full border-t border-outline-variant/30"></div>
            <div class="w-full border-t border-outline-variant/30"></div>
          </div>
          <div class="w-8"></div>
          <div class="flex flex-col items-center flex-1 z-10">
            <span id="pct-size" class="font-label-sm text-label-sm text-on-surface-variant mb-2">35%</span>
            <div id="bar-size" class="w-full max-w-[48px] bg-primary-container rounded-t-sm bar-chart-col" style="height:87.5%"></div>
            <span class="font-label-sm text-label-sm text-on-surface-variant mt-3 text-center truncate w-full px-1">Size</span>
          </div>
          <div class="flex flex-col items-center flex-1 z-10">
            <span id="pct-location" class="font-label-sm text-label-sm text-on-surface-variant mb-2">25%</span>
            <div id="bar-location" class="w-full max-w-[48px] bg-primary-container/80 rounded-t-sm bar-chart-col" style="height:62.5%"></div>
            <span class="font-label-sm text-label-sm text-on-surface-variant mt-3 text-center truncate w-full px-1">Location</span>
          </div>
          <div class="flex flex-col items-center flex-1 z-10">
            <span id="pct-bedrooms" class="font-label-sm text-label-sm text-on-surface-variant mb-2">15%</span>
            <div id="bar-bedrooms" class="w-full max-w-[48px] bg-primary-container/60 rounded-t-sm bar-chart-col" style="height:37.5%"></div>
            <span class="font-label-sm text-label-sm text-on-surface-variant mt-3 text-center truncate w-full px-1">Bedrooms</span>
          </div>
          <div class="flex flex-col items-center flex-1 z-10">
            <span id="pct-bathrooms" class="font-label-sm text-label-sm text-on-surface-variant mb-2">12%</span>
            <div id="bar-bathrooms" class="w-full max-w-[48px] bg-primary-container/50 rounded-t-sm bar-chart-col" style="height:30%"></div>
            <span class="font-label-sm text-label-sm text-on-surface-variant mt-3 text-center truncate w-full px-1">Bathrooms</span>
          </div>
          <div class="flex flex-col items-center flex-1 z-10">
            <span id="pct-age" class="font-label-sm text-label-sm text-on-surface-variant mb-2">10%</span>
            <div id="bar-age" class="w-full max-w-[48px] bg-primary-container/40 rounded-t-sm bar-chart-col" style="height:25%"></div>
            <span class="font-label-sm text-label-sm text-on-surface-variant mt-3 text-center truncate w-full px-1">Age</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant px-4 py-1 hover:text-primary transition-all active:scale-90" href="#">
<span class="material-symbols-outlined mb-1" data-icon="domain">domain</span>
<span class="font-label-md text-label-md">Assets</span>
</a>
<a class="flex flex-col items-center justify-center text-on-surface-variant px-4 py-1 hover:text-primary transition-all active:scale-90" href="#">
<span class="material-symbols-outlined mb-1" data-icon="settings">settings</span>
<span class="font-label-md text-label-md">Settings</span>
</a>
</nav>
</body></html>